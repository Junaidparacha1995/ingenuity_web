# Production server configuration
PORT=3000
SITE_URL=
TRUST_PROXY=true

# LLM / RAG — keep this server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
RAG_VECTOR_STORE_ID=

# Lead delivery. The server always validates and stores accepted leads locally in .runtime/.
# Configure a secure webhook (CRM, automation platform, or your own endpoint) before public launch.
CONTACT_WEBHOOK_URL=
REQUIRE_CONTACT_DELIVERY=false

# Optional first-party analytics/event webhook.
ANALYTICS_WEBHOOK_URL=

# Optional GitHub token for higher API limits when running npm run sync:github.
GITHUB_TOKEN=
